{
  "openapi": "3.1.0",
  "info": {
    "title": "6UMMY data API",
    "version": "1.0.0",
    "summary": "Read-only public data behind 6ummy.xyz.",
    "description": "A small, unauthenticated, read-only API that backs the 6ummy.xyz homepage. It exists only because three things cannot be done from a browser: setting a Discogs User-Agent, reading Google Calendar's no-CORS .ics feed, and hiding API keys. All data is public; there is no authentication and there are no write operations.",
    "contact": { "name": "6UMMY", "email": "sync@6ummy.xyz", "url": "https://6ummy.xyz/" },
    "license": { "name": "All rights reserved" }
  },
  "servers": [
    { "url": "https://6ummy-api.6ummy-xyz.workers.dev", "description": "Cloudflare Worker" }
  ],
  "externalDocs": { "url": "https://6ummy.xyz/llms.txt", "description": "Plain-text site overview for agents" },
  "paths": {
    "/": {
      "get": {
        "operationId": "listRoutes",
        "summary": "Route index",
        "description": "Lists the available data routes. Serves as a lightweight status/health check.",
        "responses": {
          "200": {
            "description": "The set of available routes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "routes": { "type": "array", "items": { "type": "string" }, "example": ["/live", "/dates", "/crate", "/youtube"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/live": {
      "get": {
        "operationId": "getLive",
        "summary": "Twitch live status",
        "description": "Whether the 6ummy Twitch channel is streaming right now. Deliberately never served stale.",
        "responses": {
          "200": {
            "description": "Current live status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "live": { "type": "boolean" },
                    "title": { "type": ["string", "null"] },
                    "game": { "type": ["string", "null"] },
                    "viewers": { "type": "integer" },
                    "started": { "type": ["string", "null"], "format": "date-time" },
                    "reason": { "type": "string", "description": "Present only when not configured or auth failed." }
                  },
                  "required": ["live"]
                }
              }
            }
          }
        }
      }
    },
    "/dates": {
      "get": {
        "operationId": "getDates",
        "summary": "Gig / event dates",
        "description": "Parsed from a public Google Calendar .ics feed. Recurring events (DAILY/WEEKLY/MONTHLY) are expanded. Window: 6 months back to 12 months ahead.",
        "responses": {
          "200": {
            "description": "Events plus convenience slices.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } },
                    "upcoming": { "type": "array", "items": { "$ref": "#/components/schemas/Event" }, "description": "Next events, up to 8." },
                    "past": { "type": "array", "items": { "$ref": "#/components/schemas/Event" }, "description": "Most recent past events, up to 6." },
                    "cached": { "type": "boolean" },
                    "age": { "type": "integer", "description": "Age of the served copy, in seconds." },
                    "stale": { "type": "boolean", "description": "Set when a fresh fetch failed and a stored copy is being served." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/crate": {
      "get": {
        "operationId": "getCrate",
        "summary": "Record collection",
        "description": "The public Discogs collection (folder 0), newest first, 12 items. Refreshed off the request path via a cron warmer, so a page view never spends a Discogs call.",
        "responses": {
          "200": {
            "description": "Records plus rate-limit telemetry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "auth": { "type": "boolean", "description": "Whether a Discogs token is bound (never the token itself)." },
                    "fallback": { "type": ["string", "null"], "description": "Set to 'anonymous' when the token path was throttled and the anonymous path served instead." },
                    "limit": {
                      "type": "object",
                      "properties": {
                        "ceiling": { "type": ["string", "null"] },
                        "used": { "type": ["string", "null"] },
                        "remaining": { "type": ["string", "null"] },
                        "cfCache": { "type": ["string", "null"] }
                      }
                    },
                    "records": { "type": "array", "items": { "$ref": "#/components/schemas/Record" } },
                    "cached": { "type": "boolean" },
                    "age": { "type": "integer" },
                    "stale": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/youtube": {
      "get": {
        "operationId": "getYouTube",
        "summary": "Curated playlist",
        "description": "One curated YouTube playlist in playlist order. Private and deleted entries are filtered out.",
        "responses": {
          "200": {
            "description": "Videos in playlist order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "videos": { "type": "array", "items": { "$ref": "#/components/schemas/Video" } },
                    "cached": { "type": "boolean" },
                    "age": { "type": "integer" },
                    "stale": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "where": { "type": "string" },
          "description": { "type": "string" },
          "allDay": { "type": "boolean" },
          "start": { "type": "string", "format": "date-time" },
          "startMs": { "type": "integer" },
          "endMs": { "type": "integer" }
        }
      },
      "Record": {
        "type": "object",
        "properties": {
          "id": { "type": ["integer", "string"] },
          "artist": { "type": "string" },
          "title": { "type": "string" },
          "label": { "type": "string" },
          "cat": { "type": "string" },
          "year": { "type": "string" },
          "format": { "type": "string" },
          "thumb": { "type": "string", "format": "uri" },
          "cover": { "type": "string", "format": "uri" },
          "url": { "type": "string", "format": "uri" }
        }
      },
      "Video": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "channel": { "type": "string" },
          "year": { "type": "string" },
          "published": { "type": "string", "format": "date-time" },
          "thumb": { "type": "string", "format": "uri" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
